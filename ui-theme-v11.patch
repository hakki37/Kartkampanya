+class _BrandBadge extends StatelessWidget {
+  final String label;
+  final bool compact;
+
+  const _BrandBadge({
+    required this.label,
+    this.compact = false,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    final normalized = _norm(label);
+    final isNetwork = normalized == 'visa' ||
+        normalized == 'mastercard' ||
+        normalized == 'troy';
+
+    final Color foreground;
+    final Color background;
+    final IconData? icon;
+
+    switch (normalized) {
+      case 'axess':
+        foreground = const Color(0xFFFFD54F);
+        background = const Color(0xFF3B2A00);
+        icon = Icons.credit_card_rounded;
+        break;
+      case 'bonus':
+        foreground = const Color(0xFF7CFFB2);
+        background = const Color(0xFF073D26);
+        icon = Icons.stars_rounded;
+        break;
+      case 'world':
+        foreground = const Color(0xFF8CC8FF);
+        background = const Color(0xFF082C52);
+        icon = Icons.public_rounded;
+        break;
+      case 'maximum':
+        foreground = const Color(0xFF7DB7FF);
+        background = const Color(0xFF092C57);
+        icon = Icons.auto_awesome_rounded;
+        break;
+      case 'paraf':
+        foreground = const Color(0xFFFF9AC1);
+        background = const Color(0xFF4B102A);
+        icon = Icons.account_balance_wallet_rounded;
+        break;
+      case 'bankkart':
+        foreground = const Color(0xFFFFD76A);
+        background = const Color(0xFF443400);
+        icon = Icons.account_balance_rounded;
+        break;
+      case 'saglam kart':
+      case 'sağlam kart':
+        foreground = const Color(0xFF8FE3FF);
+        background = const Color(0xFF073447);
+        icon = Icons.shield_rounded;
+        break;
+      case 'cepteteb':
+        foreground = const Color(0xFF73D7FF);
+        background = const Color(0xFF063A50);
+        icon = Icons.phone_android_rounded;
+        break;
+      case 'visa':
+        foreground = const Color(0xFF9FC4FF);
+        background = const Color(0xFF0A2D66);
+        icon = Icons.credit_card_rounded;
+        break;
+      case 'mastercard':
+        foreground = const Color(0xFFFFB0A8);
+        background = const Color(0xFF521713);
+        icon = Icons.credit_card_rounded;
+        break;
+      case 'troy':
+        foreground = const Color(0xFF7FE7D3);
+        background = const Color(0xFF063D36);
+        icon = Icons.credit_card_rounded;
+        break;
+      default:
+        foreground = Theme.of(context).colorScheme.onSurfaceVariant;
+        background = Theme.of(context).colorScheme.surfaceContainerHighest;
+        icon = isNetwork ? Icons.credit_card_rounded : Icons.credit_card_outlined;
+    }
+
+    final text = label.trim();
+    if (text.isEmpty) return const SizedBox.shrink();
+
+    return Container(
+      padding: EdgeInsets.symmetric(
+        horizontal: compact ? 8 : 10,
+        vertical: compact ? 5 : 6,
+      ),
+      decoration: BoxDecoration(
+        color: background,
+        borderRadius: BorderRadius.circular(9),
+        border: Border.all(color: foreground.withOpacity(.32)),
+      ),
+      child: Row(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          Icon(icon, size: compact ? 13 : 14, color: foreground),
+          const SizedBox(width: 5),
+          Text(
+            text.toUpperCase(),
+            style: TextStyle(
+              color: foreground,
+              fontSize: compact ? 10 : 10.5,
+              fontWeight: FontWeight.w900,
+              letterSpacing: .35,
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+}
